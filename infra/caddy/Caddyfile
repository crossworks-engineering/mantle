# Mantle front door: ONE release-owned Caddyfile for every box.
#
# Nothing in this file is box-specific. Two things vary per deployment and
# both come from the environment, never from editing this file on a box:
#
#   MANTLE_SITE_ADDRESS   the address Caddy serves. A hostname gets automatic
#                         HTTPS (Let's Encrypt; point DNS at the box, open 80
#                         + 443 first); ":80" (the default) is plain HTTP for
#                         local testing. A comma-separated list routes and
#                         certificates every name.
#   MANTLE_CADDY_SHAPE    how the two apps share the front door:
#                           same-origin  (default) one domain, path-routed.
#                                        /api, /s, /print and the runtime
#                                        bundles go to the server app, all
#                                        else to the owner UI. No extra DNS,
#                                        no CORS. Every fleet box runs this.
#                           split        the server app owns the whole domain
#                                        and the owner UI lives on its own
#                                        vhost (MANTLE_CLIENT_SITE_ADDRESS,
#                                        the second site block below). Needs
#                                        the DNS record + MANTLE_API_CORS_ORIGINS.
#                         The shape is a file under infra/caddy/shapes/,
#                         imported into the site block below.
#
# Box-local routes (a client's MCP bridge behind a public path, say) go in
# infra/caddy/conf.d/*.caddy, imported below; they survive every roll. See
# infra/caddy/README.md. The updater refreshes THIS file and the shapes from
# the release image when the box copy is pristine, exactly like compose; a
# hand-edited copy is left alone and reported as drift.
#
# Caddy reaches the apps over the internal docker network (web:3000,
# client-web:3000); no app publishes a public port. ACME state lives under
# the caddy data bind mount (persist it, or you'll hit Let's Encrypt rate
# limits on redeploys).
{$MANTLE_SITE_ADDRESS::80} {
	encode zstd gzip

	# Access log: JSON on stdout, so `docker logs mantle_caddy` answers "did
	# that request even arrive, and how did it end?". Credentials are redacted
	# by default. Without this an upload that died at the proxy left no trace
	# anywhere: a 250 MB upload spun for half an hour with nothing to read.
	#
	# Sign-in secrets never reach the log (client logins audit B12): a `code`
	# query parameter (a client sign-in link or member invite issued before
	# the code moved into the URL fragment, an OAuth callback) and the invite
	# code in the path of the invite lookup are replaced with REDACTED, and
	# the Referer header (which carried the page URL, code and all, on every
	# subresource) is dropped.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(^/api/auth/invite/)[A-Za-z0-9]{16}|([?&]code=)[^&#]*" "${1}${2}REDACTED"
			request>headers>Referer delete
		}
	}

	# The pages a sign-in link opens: their URL can carry a code (links issued
	# before it moved into the fragment), so the browser must never send it on
	# as a Referer. Set at the edge, whichever app answers the page.
	@signin_pages path /client-signin /client-signin/* /invite /invite/*
	header @signin_pages >Referrer-Policy no-referrer

	# Box-local drop-ins: extra routes such as a database MCP bridge on a client
	# box, or a customer vhost's paths. One file per concern in
	# infra/caddy/conf.d/*.caddy, imported HERE so this file is never edited
	# on a box and a release roll cannot wipe a route. Caddy orders handle
	# blocks by path length, so a drop-in `handle /x/*` wins over the shape's
	# catch-all wherever it lands. A missing or empty folder is fine.
	import /etc/caddy/conf.d/*.caddy

	# The routing shape (see the header). One of infra/caddy/shapes/*.caddy.
	import /etc/caddy/shapes/{$MANTLE_CADDY_SHAPE:same-origin}.caddy

	# Body cap. {$MANTLE_MAX_BODY_SIZE:1GB} must stay ABOVE the app's streamed
	# upload cap (MANTLE_MAX_UPLOAD_MB, default 512) plus multipart framing;
	# the app refuses oversize files itself with a proper 413, this is the
	# backstop. Raise both together.
	request_body {
		max_size {$MANTLE_MAX_BODY_SIZE:1GB}
	}
}

# The owner-UI vhost of the SPLIT shape. Inert under same-origin: the address
# defaults to :8080, which listens inside the container, is not published, and
# gets no traffic, so a same-origin or server-only box never ACME-thrashes a
# hostname it doesn't serve. Under split, set MANTLE_CLIENT_SITE_ADDRESS to
# app.<domain> and point DNS at the box.
{$MANTLE_CLIENT_SITE_ADDRESS::8080} {
	encode zstd gzip
	# The sign-in link pages live on this vhost under split: see above.
	@signin_pages path /client-signin /client-signin/* /invite /invite/*
	header @signin_pages >Referrer-Policy no-referrer
	reverse_proxy client-web:3000
	request_body {
		max_size {$MANTLE_MAX_BODY_SIZE:1GB}
	}
}
