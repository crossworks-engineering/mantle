{
  "id": "lx9-logger-py",
  "name": "LX-9 data logger (Python)",
  "description": "Reads an LX-9 logger export and writes its readings and its header as tabs.",
  "version": "1.0.0",
  "api": 1,
  "kit": 1,
  "runtime": "python",
  "entry": "step.py",
  "start": "upload",
  "match": { "ext": ["lx9"] },
  "produces": {},
  "needs": { "weight": "light", "timeMs": 60000, "tools": ["file_tabs_write"] },
  "options": {
    "max_rows": {
      "type": "number",
      "label": "Most readings",
      "default": 200000,
      "min": 1000,
      "max": 500000
    }
  }
}
