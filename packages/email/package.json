    "@mantle/db": "workspace:*",
    "@mantle/rules": "workspace:*",
    "@mantle/std": "workspace:*",
    "@mantle/storage": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "imapflow": "^2.2.6",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.15",
    "pg-boss": "^12.37.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
