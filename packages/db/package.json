{
  "name": "@mantle/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./viewer": "./src/viewer.ts",
    "./runtime-role": "./src/runtime-role.ts",
    "./store-broker": "./src/store-broker.ts",
    "./sql-text": "./src/sql-text.ts",
    "./test-support": "./src/test-support.ts",
    "./matrix/oracle": "./src/matrix/oracle.ts",
    "./matrix/guide-oracle": "./src/matrix/guide-oracle.ts",
    "./matrix/a8-grid": "./src/matrix/test-support/a8-grid.ts",
    "./matrix/a8-known-failures": "./src/matrix/a8-known-failures.ts",
    "./matrix/a8-tool-cells": "./src/matrix/test-support/a8-tool-cells.ts",
    "./matrix/a8-tool-content": "./src/matrix/test-support/a8-tool-content.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=../../server/web/.env.local src/migrate.ts",
    "studio": "node --env-file-if-exists=../../server/web/.env.local --import tsx node_modules/drizzle-kit/bin.cjs studio",
    "init-scratch": "tsx src/init-scratch.ts",
    "oracle:answers": "tsx src/matrix/oracle-answers-cli.ts",
    "drop-viewer-logins": "tsx --env-file-if-exists=../../server/web/.env.local src/drop-viewer-logins.ts"
  },
  "dependencies": {
    "@mantle/client-types": "workspace:*",
    "@mantle/config": "workspace:*",
    "@mantle/std": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
