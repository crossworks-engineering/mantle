{
  "name": "@mantle/share-ui",
  "version": "0.0.1",
  "description": "The server-rendered share surface — the /s/<token> presenters, view-payload contract, mini-app sandbox, and the few primitives they need. Lives in MANTLE (the server renders these), published for jackdaw to consume; may depend only on @mantle/{client-types,content-core} (the jackdaw-repo-split boundary).",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "themes:build": "node themes/generate.mjs",
    "themes:check": "node themes/generate.mjs --check",
    "themes:report": "node themes/generate.mjs --report"
  },
  "exports": {
    "./app-presenter": "./src/app-presenter.tsx",
    "./draw-presenter": "./src/draw-presenter.tsx",
    "./event-presenter": "./src/event-presenter.tsx",
    "./file-presenter": "./src/file-presenter.tsx",
    "./formula-calculator": "./src/formula-calculator.tsx",
    "./formula-presenter": "./src/formula-presenter.tsx",
    "./note-presenter": "./src/note-presenter.tsx",
    "./table-presenter": "./src/table-presenter.tsx",
    "./task-presenter": "./src/task-presenter.tsx",
    "./view-payload": "./src/view-payload.ts",
    "./app-sandbox": "./src/app-sandbox.tsx",
    "./app-frame-html": "./src/app-frame-html.ts",
    "./app-bridge-protocol": "./src/app-bridge-protocol.ts",
    "./ui/button": "./src/ui/button.tsx",
    "./ui/input": "./src/ui/input.tsx",
    "./ui/label": "./src/ui/label.tsx",
    "./lib/presenter-chrome": "./src/lib/presenter-chrome.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./page-outline": "./src/page-outline.tsx",
    "./nav-items": "./src/nav-items.ts",
    "./help-topics": "./src/help-topics.ts",
    "./appearance": "./src/appearance.ts",
    "./neat-background": "./src/neat-background.ts",
    "./neat-mount": "./src/neat-mount.ts",
    "./share-mode": "./src/share-mode.ts",
    "./backgrounds": "./src/backgrounds.ts",
    "./avatar": "./src/avatar.ts",
    "./lib/themes": "./src/lib/themes.ts",
    "./styles/themes.css": "./styles/themes.css",
    "./styles/app.css": "./styles/app.css"
  },
  "dependencies": {
    "@firecms/neat": "1.0.2",
    "@mantle/client-types": "workspace:*",
    "@mantle/content-core": "workspace:*",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^26.4.0"
  }
}
