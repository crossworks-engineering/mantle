  "nodes": [
    { "id": "agent", "label": "Presenter agent", "tag": "agent", "kind": "input" },
    { "id": "api", "label": "Present API", "sublabel": "/api/presents", "group": "brain" },
    { "id": "db", "label": "presents table", "sublabel": "source, poster", "kind": "store", "shape": "cylinder", "group": "brain" },
    { "id": "runtime", "label": "Canvas runtime", "sublabel": "/canvas-runtime/", "group": "brain" },
    { "id": "frame", "label": "Canvas frame", "sublabel": "allow-scripts only", "kind": "focal", "group": "sandbox" },
