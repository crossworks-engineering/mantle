{
  "name": "@mantle/diagram-templates",
  "version": "0.0.1",
  "description": "Diagram templates: the agent writes data, the template lays it out, draws it in the house style and exports a static SVG. Each template is a self-contained Present canvas.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "render": "node scripts/render.ts",
    "samples": "node scripts/build.ts && node scripts/render.ts --all",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
