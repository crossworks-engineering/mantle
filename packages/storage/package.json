{
  "name": "@mantle/storage",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "objectstore:ensure": "tsx --env-file-if-exists=../../server/web/.env.local src/cli.ts ensure",
    "objectstore:verify": "tsx --env-file-if-exists=../../server/web/.env.local src/cli.ts verify",
    "objectstore:copy-from": "tsx --env-file-if-exists=../../server/web/.env.local src/cli.ts copy-from"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@mantle/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
