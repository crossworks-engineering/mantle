# Copy to .env.local at the repo root. Each app reads what it needs from process.env.

# Postgres connection (Drizzle + pg-boss use this directly).
# Lean stack: postgres in docker on 54323. Old Supabase tunnel was 54322.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54323/postgres

# --- DB-less frontend dev (optional) ------------------------------------------
# Set these to run `pnpm dev:fe` (client/web) against a DEPLOYED Mantle's HTTP API
# instead of a local Postgres — no DATABASE_URL / Tailscale needed. Mint the
# token against the remote: POST {email,password} to <remote>/api/auth/mobile-login.
# Inert when unset (normal in-process DB access). MANTLE_DETACHED_DEV=1 turns it on;
# MANTLE_API_TOKEN is the bearer the detached client uses (see lib/auth/session.ts).
# MANTLE_DETACHED_DEV=1
# MANTLE_API_TOKEN=

# --- Auth ---------------------------------------------------------------------
# Used to HMAC the session cookie. >=32 chars. Generate: openssl rand -base64 48
# Rotating this invalidates every existing session.
SESSION_SECRET=

# --- Object storage (self-hosted MinIO in docker-compose.dev.yml) -------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=mantle

# --- Host filesystem for the /files surface -----------------------------------
# Where the files.* tree is mirrored on disk (uploads, Saskia's file_create,
# Telegram photos, generated images). MUST be an ABSOLUTE path SHARED by every
# process — web, agent, and the workers. If left unset it defaults to a
# cwd-relative ./data/files, which means each process uses a different root and
# files written by one (e.g. a web upload) are invisible to another (e.g. the
# agent's extractor). Set this.
MANTLE_FILES_ROOT=/absolute/path/to/data/files

# Per-table SQLite workbooks for sqlite-native Tables (one file per Table node).
# Same rule as MANTLE_FILES_ROOT: an ABSOLUTE path SHARED by web AND api — both
# run table tool handlers (the agent writes via api, the UI reads via web). If
# unset it defaults to a monorepo-root ./.table-dbs (fine for local dev), but on
# a deployed box it MUST be the shared bind mount, or a workbook written by one
# process is invisible to the other and every table open 500s. In the shipped
# docker-compose.yml this is /data/table-dbs, bind-mounted into web AND api.
TABLE_DB_DIR=/absolute/path/to/data/table-dbs

# Per-app SQLite for the /apps mini-app builder (one file per app). Same
# shared-absolute-path rule as above (web AND api serve /apps). Compose default
# is /data/app-dbs. Unset → cwd-relative ./.app-dbs (dev only).
APP_DB_DIR=/absolute/path/to/data/app-dbs

# Documentation root: where the docs-sync worker reads markdown for the
# `documentation` node type (the /docs viewer + Docs agent). Defaults to a
# cwd-relative ./docs; set it to the repo's docs/ as an absolute path shared by
# every process. Indexing is opt-in per collection at /settings/documentation.
MANTLE_DOCS_ROOT=/absolute/path/to/mantle/docs

# --- Document parsing fallback (Apache Tika) ----------------------------------
# Mantle's in-process parsers (pdf-parse / mammoth / SheetJS) handle PDF, DOCX,
# XLSX/XLS, and plain text directly. For everything else — LibreOffice native
# (.odt/.ods/.odp), PowerPoint (.pptx/.ppt), legacy Word (.doc), RTF, EPUB —
# parseDocumentBytes falls through to Apache Tika. Tika runs as a sibling
# docker service (`mantle_dev_tika`, see docker-compose.dev.yml) on 9998; the
# default below assumes dev (host port). In prod docker-compose, web/agent/
# workers reach Tika by service name via TIKA_URL=http://tika:9998. The Tika
# wrapper is never-throws — if the service is down or the bytes are
# unparseable, the extractor records skipped:no_text_layer (honest skip).
TIKA_URL=http://127.0.0.1:9998

# --- PDF export (browser sidecar) -----------------------------------------------
# The Pages → PDF export drives a browserless/chromium sidecar — run like Tika
# as a sibling docker service (`mantle_dev_browser`, docker-compose.dev.yml) on
# host port 9222. server/web connects over websocket with puppeteer-core; the
# token matches the service's TOKEN env. If the sidecar is down, PDF export
# returns a clean 503 (Markdown/Word are unaffected). In prod docker-compose
# this is set by service name: BROWSER_WS_ENDPOINT=ws://browser:3000?token=….
BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222?token=mantle

# --- Video ingest (media sidecar) -----------------------------------------------
# video_ingest fetches a video by URL (yt-dlp), extracts a speech-grade audio
# clip (ffmpeg) and transcribes it. The binaries live in their own sidecar
# (`mantle_dev_media`, docker-compose.dev.yml) on host port 8095 — no DB, no
# secrets, no file-store access. Unset = the tool refuses cleanly with "not
# enabled on this box". Dev token matches the service's MEDIA_TOKEN. In prod
# compose this is by service name behind the `media` profile:
# MEDIA_SIDECAR_URL=http://media:8095 + a real MEDIA_SIDECAR_TOKEN.
MEDIA_SIDECAR_URL=http://127.0.0.1:8095
MEDIA_SIDECAR_TOKEN=mantle

# --- Mantle ---------------------------------------------------------------------
# 32 random bytes, base64-encoded. Generate: openssl rand -base64 32
MANTLE_MASTER_KEY=

# OPTIONAL. UUID of the single user in auth.users — used by the MCP server +
# workers to scope queries. Leave BLANK for a normal self-hosted setup: the
# runtime auto-resolves the sole auth.users row, so a fresh install just needs
# you to create your account in the web app (first visit → "Create your
# account"). Only set this for scripts, or to disambiguate a multi-DB setup.
#   psql $DATABASE_URL -tA -c "SELECT id FROM auth.users LIMIT 1"
ALLOWED_USER_ID=

# Base URL the Mantle Next.js app is reachable at. Used by server-side code
# that generates absolute links (worker notifications, MCP tool responses)
# where there's no incoming HTTP request to derive a host from. The agent also
# uses it to build public /s/<token> share links (page_share, email_page's
# includeLink); set MANTLE_PUBLIC_URL to override it for the agent only.
# Dev:  http://localhost:3000
# Prod: https://<your-public-host>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Embeddings (optional in v1, required for AI semantic search) --------------
OPENAI_API_KEY=

# --- MCP server ----------------------------------------------------------------

# --- Terminal tool (power-user coder agent) -----------------------------------
# Default working directory for the `run_terminal` builtin tool. Set to the
# mantle repo so git/pnpm/migrations "just work"; commands can override per call.
# In prod this runs INSIDE the agent container — host actions need a separate hatch.
MANTLE_TERMINAL_CWD=/path/to/your/mantle/checkout

# --- CLI sandboxes (compose profile `sandboxes`) -------------------------------
# Persistent isolated Ubuntu containers the coder agent works in, managed by the
# sandboxd sidecar. FRESH installs get this ON by default — scripts/install.sh
# writes the profile + both vars below (opt out: --no-sandboxes). Existing boxes
# stay as they are; enable with `install.sh --sandboxes` or set
# COMPOSE_PROFILES=sandboxes plus BOTH vars by hand. Each sandbox's /files lives
# under MANTLE_SANDBOXES_HOST_DIR (must be HOST-ABSOLUTE — it is handed to the
# host Docker daemon as a bind source) and survives sandbox removal.
# SANDBOXD_TOKEN=generate-with-openssl-rand-hex-32
# MANTLE_SANDBOXES_HOST_DIR=/opt/mantle-data/sandboxes
# Default sandbox image: titanwest/mantle-sandbox (batteries included — python3
# + common libs, node22 + pnpm, git, docker CLI, claude code; built from
# infra/sandbox-image/Dockerfile). Override to pin differently:
# SANDBOX_DEFAULT_IMAGE=titanwest/mantle-sandbox:24.04-v2
# Balanced-tier extra egress hosts (comma-separated; registries/GitHub/apt
# mirrors are always allowed): SANDBOX_EGRESS_ALLOW=api.example.com

# --- Runner queues (OFF by default — pre-release) ------------------------------
# Durable background runs (docs/runs.md): the responder delegates multi-step
# jobs to a queued plan (tool calls + worker-agent steps + automatic audits),
# executed by the runs worker (`pnpm -C server/web worker:runs:dev`) and tracked
# at /debug/runs. Unset = engine dark: run_plan/run_append refuse, the worker
# idles. Enable, then grant the `runs` tool group to your persona.
# MANTLE_RUNS=1
# Concurrent worker-agent steps per run (each is a whole LLM turn). Default 3.
# MANTLE_RUNS_WORKER_CONCURRENCY=3
# Cap on the dedicated background-runs queue in server/api — what stops a run
# fanning out N worker turns from queueing ahead of a live chat message.
# Default 2.
# MANTLE_RUNS_TURN_CONCURRENCY=2

# --- Microsoft / Outlook (optional) --------------------------------------------
# Azure app-registration credentials for /settings/microsoft (mail + drive
# ingest, docs/microsoft-graph-ingest.md). Add Mail.Send to the app's scopes
# BEFORE the first connect, or you get a read-only token you must re-consent.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
# MS_REDIRECT_URI=https://your.host/api/microsoft/callback

# --- Team Hub (optional) --------------------------------------------------------
# Member chat posting is OFF unless this is exactly "1".
# TEAM_CHAT_POST_ENABLED=1
# Per-owner daily gates (forum-gate.ts).
# TEAM_CHAT_DAILY_TURNS=200
# TEAM_UPLOAD_DAILY_BYTES=104857600

# --- Networking -----------------------------------------------------------------
# Proxy hops in front of the app, for client-IP extraction in the rate limiter
# (X-Forwarded-For, counted from the right). Default 1 = a single Caddy. Set to
# 2 behind Caddy + Cloudflare, or the limiter keys on a spoofable hop.
# MANTLE_TRUSTED_PROXIES=1
