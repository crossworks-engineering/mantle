# The demo's Caddy block — the read-only edge.
#
# Goes into the mantle-site Caddyfile in place of the parked redirect (see that
# repo's DEPLOY.md, "The demo subdomain"). Two placeholders are substituted at
# deploy time by demo/scripts/render-caddy.sh:
#
#   __DEMO_SESSION__   the minted session cookie value (demo/seed/mint-session.ts)
#   __DEMO_MOBILE_TOKEN__  the phone-app bearer (demo/seed/mint-mobile-token.ts)
#   __DEMO_WEB__       upstream host:port of the demo client
#   __DEMO_API__       upstream host:port of the demo API
#
# ONE ORIGIN by design: the browser calls /api/** on this same host, so there
# is no CORS anywhere. That recipe came from v1 and is the one part of it worth
# keeping.
#
# NOTE the ordering below is load-bearing. Caddy evaluates `handle` blocks in
# order, and the write-rejection MUST come before the proxies — put it after
# and every write sails through to a real backend.

demo.mantle-ai.tech {
	encode zstd gzip

	# ── Layer 1: refuse every write, before anything is proxied ──────────
	# GET/HEAD/OPTIONS only. Everything else gets an honest 403 rather than
	# a faked 200: a bogus success desyncs the screen's cache and makes the
	# demo look broken, which is worse than an obvious "you can't do that".
	# The app already renders this as a clean toast — v1 proved it.
	# ── Store reviewers: the phone app signs in here ──────────────────────
	# The phone app authenticates with POST /api/auth/mobile-login, which the
	# write block below would refuse. The edge answers it itself, for ANY
	# username and password, with a bearer minted for the demo owner by
	# demo/seed/mint-mobile-token.ts (a real mobile_tokens row, one-year TTL).
	# Reads then work with that bearer; writes still meet the 403 below. Logout
	# is a no-op so the app's sign-out never errors. Must sit BEFORE @writes.
	handle /api/auth/mobile-login {
		header Content-Type application/json
		respond `{"token":"__DEMO_MOBILE_TOKEN__","expiresIn":31536000}` 200
	}
	handle /api/auth/mobile-logout {
		header Content-Type application/json
		respond `{}` 200
	}
	# ── Two POSTs that are reads, admitted BEFORE the refusal below ──────
	# Found by the coverage gate after the v0.232.195 / jackdaw v0.6.112 roll.
	#
	# POST /api/auth/sso: the shell fires it once per page load whenever it
	# holds a bearer — a silent bearer→cookie upgrade that "grants nothing new"
	# (server/web/lib/owner-sso.ts). Every visitor here already carries the
	# injected owner cookie, so answer the 204 it expects; a 403 landed in the
	# console of every single screen and told a visitor nothing true.
	@sso {
		method POST
		path /api/auth/sso
	}
	handle @sso {
		respond 204
	}

	# POST /api/apps/<id>/frame-ticket mints the seconds-lived signed ticket
	# the sandboxed app iframe presents to GET …/frame (the frame carries no
	# cookie, so THIS call is where the owner authenticates). It writes
	# nothing — an HMAC over the session — and without it every mini-app
	# shows its "not built" state behind a 403. Proxy it to the real API.
	@frameTicket {
		method POST
		path /api/apps/*/frame-ticket
	}
	handle @frameTicket {
		reverse_proxy __DEMO_API__
	}

	@writes not method GET HEAD OPTIONS
	handle @writes {
		header Content-Type application/json
		respond `{"error":"This is a read-only demo — changes are not saved."}` 403
	}

	# ── The visitor is the demo owner, without ever seeing a login ────────
	# TWO cookies are required, and missing the second sends every visitor to
	# a login screen even though the API is perfectly authenticated:
	#
	#   mantle_session  the real credential. An HMAC over SESSION_SECRET, so
	#                   Caddy cannot sign one — it is minted at deploy time
	#                   (demo/seed/mint-session.ts) and injected here.
	#   mantle_authed   client/web's PRESENCE cookie. Its middleware redirects
	#                   to /login whenever this is absent, purely so a page
	#                   load does not flash an empty shell before bouncing.
	#                   It is spoofable by construction and grants nothing —
	#                   the session above is what actually authenticates.
	#
	# There is no third cookie any more. `mantle_team_chat` admitted a visitor
	# to the old team portal (/team, /hub). Main retired that portal with
	# member logins: a team member is a login of its own and signs in with
	# this SAME `mantle_session` cookie, so one request is the owner or a
	# member, never both, and /team and /hub now answer a redirect to /login.
	# The visitor here is the owner (admin), who sees the team from the
	# admin side: the Team screen, the member chats, what the team reads.
	# Showing the MEMBER's own view needs a second origin that injects a
	# member's session (demo/seed/mint-session.ts mints one for any login).
	#
	# Set on the REQUEST only: never handed back to the browser, so neither
	# can be lifted from a shared machine's cookie jar afterwards.
	request_header Cookie "mantle_session=__DEMO_SESSION__; mantle_authed=1"

	# /api/activity used to be answered HERE with an empty LiveActivity,
	# because getLiveActivity() reconciles orphaned traces before listing them
	# — a GET that WRITES, refused as demo_reader (42501), 500ing the
	# always-on Activity surface on every poll from every screen.
	#
	# That is fixed upstream now (reapAbandonedTraces skips a refused write and
	# still serves the read), so the intercept is GONE and the demo shows its
	# real activity — roughly 1300 traces that were previously hidden behind a
	# hardcoded empty response.
	#
	# Two things the old comment here got wrong, recorded so they are not
	# repeated: it did NOT take the API process down (the rejection is awaited
	# into the route, so it surfaced as a 500 and the process stayed up), and
	# fixing it did NOT require breaking the no-app-changes invariant — the
	# invariant is about the DEMO branch not editing app code, and the fix
	# belongs on main, which is where it went.

	# Everything the SERVER app serves — the same list as the standard
	# same-origin shape (infra/caddy/shapes/same-origin.caddy): the API, share
	# pages and print views, and the two runtimes the mini-app sandbox frame
	# loads its stylesheets and modules from. The first version of this file
	# routed only /api/* and let /share-runtime/* fall through to the client,
	# which 404s it: every mini-app rendered as bare text with no stylesheet,
	# and nothing anywhere said why.
	@server path /api /api/* /s /s/* /print /print/* /share-runtime/* /app-runtime/*
	handle @server {
		reverse_proxy __DEMO_API__
	}

	handle {
		reverse_proxy __DEMO_WEB__
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The demo is a live product surface and must not be framed by a
		# third party, but the guided tour (P8) may want to embed it on the
		# marketing site — same-origin framing stays allowed.
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}
