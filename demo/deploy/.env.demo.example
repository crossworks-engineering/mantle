# Serve-time environment for the public demo. Copy to `.env.demo` ON THE BOX
# and fill in the three values that have no safe default.
#
#   docker compose -f docker-compose.demo.yml --env-file .env.demo up -d --wait
#
# `.env.demo` itself is NOT committed — SESSION_SECRET and MANTLE_MASTER_KEY
# are the brain's seals, and this repo is public.

# ── Must match the seed exactly ──────────────────────────────────────────────
# Whatever demo/scripts/seed.sh ran with. A different SESSION_SECRET does not
# error — it silently invalidates the injected cookies and every visitor meets
# a login screen. A different MANTLE_MASTER_KEY leaves the vault unopenable.
SESSION_SECRET=
MANTLE_MASTER_KEY=

# ── The public origin ────────────────────────────────────────────────────────
# Not optional. Also becomes the client's MANTLE_SERVER_ORIGIN, so it must be
# the EDGE's origin (what a visitor types), never an internal service address.
MANTLE_PUBLIC_URL=https://demo.mantle-ai.tech

# ── The release ──────────────────────────────────────────────────────────────
# Pin the tag the brain was seeded on. Server and client are lockstep — never
# roll one without the other.
MANTLE_IMAGE_TAG=v0.217.1
MANTLE_IMAGE_NAMESPACE=titanwest

# ── Where the shipped brain data lives ───────────────────────────────────────
# restore.sh WRITES these five in for you, pointing at the unpacked bundle. You
# only set them by hand if the payloads live somewhere other than the bundle.
#
# They are REQUIRED and must be ABSOLUTE — the compose has no defaults for them
# any more. It used to, and they were workstation-relative: compose resolves a
# relative path against the compose file's directory, so a `docker compose up`
# run without this env silently pointed postgres at a different directory,
# created an EMPTY cluster, and came up healthy. The app then answered
# "password authentication failed for demo_reader" on every request, because
# the role exists only in the real brain.
#
#   DEMO_DATA_DIR      postgres + minio + ollama + app-dbs live under here
#   DEMO_DOCS_ROOT     generated demo docs, and it MUST contain guide/06-help
#   DEMO_FILES_ROOT    the file bytes
#   DEMO_TABLE_DB_DIR  the SQLite workbooks
#   DEMO_PG_INIT_DIR   an EMPTY directory when restoring a dump — the dump
#                      carries its own extensions and auth schema
#DEMO_DATA_DIR=/srv/demo/data
#DEMO_DOCS_ROOT=/srv/demo/docs
#DEMO_FILES_ROOT=/srv/demo/files
#DEMO_TABLE_DB_DIR=/srv/demo/table-dbs
#DEMO_PG_INIT_DIR=/srv/demo/.no-init

# ── Loopback ports (restore path + on-box debugging, never the serving path) ─
# Non-default on purpose; a port collision costs the container its whole
# network, silently. Change these if the box already uses them.
#DEMO_PG_PORT=57432
#DEMO_MINIO_PORT=57900
#DEMO_WEB_PORT=57080
#DEMO_CLIENT_PORT=57081

# ── Rarely changed ───────────────────────────────────────────────────────────
# Proxy hops in front of the app, for client-IP extraction in the rate limiter.
# 1 = the site's Caddy alone. Make it 2 behind Cloudflare.
#MANTLE_TRUSTED_PROXIES=1
#POSTGRES_PASSWORD=postgres
#S3_ACCESS_KEY=minio
#S3_SECRET_KEY=minio12345

# Only read when you deliberately start the `local-embedder` profile. The demo
# embeds online, through the route named in the brain's embedding_config —
# see README-embedder.md, which also covers the re-embed that must happen on
# the workstation BEFORE the dump is taken.
#OLLAMA_KEEP_ALIVE=24h
