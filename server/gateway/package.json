{
  "name": "@mantle/gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --env-file-if-exists=../web/.env.local src/main.ts",
    "start": "node --env-file-if-exists=../web/.env.local --import tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantle/config": "workspace:*",
    "@mantle/db": "workspace:*",
    "@mantle/std": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
