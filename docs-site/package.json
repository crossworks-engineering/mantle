{
  "name": "mantle-docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "brand": "node scripts/sync-brand.mjs",
    "tools": "pnpm -C ../server/web exec tsx ../../docs-site/scripts/mcp-tools.ts",
    "prepare-data": "node scripts/sync-brand.mjs && (pnpm run tools || echo 'mcp-tools: skipped (install the mantle workspace at the repo root to include the MCP tool page)')",
    "dev": "pnpm run prepare-data && astro dev",
    "build": "pnpm run prepare-data && astro build",
    "preview": "astro preview",
    "check": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "astro": "^7.3.7",
    "sharp": "^0.35.5"
  }
}
